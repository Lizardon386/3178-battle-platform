{
  "name": "battle-platform",
  "version": "0.1.0",
  "private": true,
  "description": "游戏无关的宿主制联机对战平台内核（war3 式房间）",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/testkit"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "seam": "bash tools/checks/check-seam.sh",
    "boundaries": "node tools/checks/check-boundaries.mjs",
    "check:refs": "node tools/checks/check-build-references.mjs",
    "check:lock": "node tools/checks/check-lock.mjs",
    "check:contract": "node packages/protocol-contract/scripts/gen-types.mjs --check",
    "smoke:package": "node tools/checks/smoke-bp-game.mjs",
    "smoke:supervisor": "node tools/checks/smoke-supervisor.mjs",
    "smoke:web": "node tools/checks/smoke-web.mjs",
    "test:ui": "node tools/checks/run-ui-tests.mjs",
    "test:supervisor": "node tools/checks/run-dotnet-tests.mjs tests/BattlePlatform.Supervisor.Tests/BattlePlatform.Supervisor.Tests.csproj",
    "pack:win": "node tools/packaging/pack-win.mjs",
    "upgrade": "node tools/packaging/upgrade.mjs",
    "verify": "npm run check:refs && npm run check:lock && npm run check:contract && npm test && npm run boundaries",
    "portable": "node tools/packaging/build-portable.mjs",
    "pack:sdk": "node tools/packaging/pack-sdk.mjs",
    "bump:sdk": "node tools/packaging/bump-sdk.mjs",
    "test": "npm run build && node tools/testkit/scripts/pack-test-games.mjs && node --test --test-timeout=20000 \"packages/*/test/*.test.mjs\" \"tools/*/test/*.test.mjs\" \"examples/*/test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "quicktype": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
