{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Lizardon386/3178-battle-platform/protocol/v0/manifest.schema.json",
  "title":"3178 language-neutral game manifest v0",
  "type":"object",
  "required":["id","version","platformRequirements","entryPoints","sessionConfig","reference"],
  "additionalProperties":false,
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version":{"type":"string","minLength":1,"maxLength":32},
    "platformRequirements":{
      "type":"object","required":["protocolVersion","minPlayers","maxPlayers"],"additionalProperties":false,
      "properties":{
        "protocolVersion":{"type":"integer","minimum":0,"maximum":0},
        "minPlayers":{"type":"integer","minimum":1,"maximum":8},
        "maxPlayers":{"type":"integer","minimum":2,"maximum":8},
        "allowSpectate":{"type":"boolean"},
        "soloFill":{"type":"boolean"}
      }
    },
    "entryPoints":{
      "type":"object","required":["authority"],"additionalProperties":false,
      "properties":{
        "authority":{"$ref":"#/$defs/assetPath"},
        "web":{"$ref":"#/$defs/assetPath"}
      }
    },
    "assets":{"type":"array","items":{"$ref":"#/$defs/asset"},"uniqueItems":true},
    "signature":{
      "type":"object","required":["algorithm","value"],"additionalProperties":false,
      "properties":{"algorithm":{"const":"ed25519"},"value":{"type":"string","minLength":16,"maxLength":512},"publicKey":{"type":"string","minLength":16,"maxLength":256}}
    },
    "rulesHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "sessionConfig":{
      "type":"object","required":["fields"],"additionalProperties":false,
      "properties":{
        "fields":{"type":"array","items":{"$ref":"#/$defs/field"},"uniqueItems":true},
        "seatOptions":{"type":"array","items":{"$ref":"#/$defs/field"},"uniqueItems":true}
      }
    },
    "reference":{
      "type":"object","required":["entry"],"additionalProperties":false,
      "properties":{"entry":{"$ref":"#/$defs/assetPath"}}
    }
  },
  "$defs":{
    "assetPath":{"type":"string","pattern":"^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$","maxLength":256},
    "asset":{
      "type":"object","required":["path","sha256","bytes"],"additionalProperties":false,
      "properties":{
        "path":{"$ref":"#/$defs/assetPath"},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "bytes":{"type":"integer","minimum":0}
      }
    },
    "field":{
      "type":"object","required":["key","type","label","default"],"additionalProperties":false,
      "properties":{
        "key":{"type":"string","pattern":"^[a-z][a-z0-9-]*$","maxLength":64},
        "type":{"enum":["boolean","enum","number","string"]},
        "label":{"type":"string","minLength":1,"maxLength":64},
        "description":{"type":"string","maxLength":512},
        "default":{},
        "options":{"type":"array","items":{"$ref":"#/$defs/option"},"minItems":1},
        "roles":{"type":"array","items":{"enum":["host","player","ai","spectator"]},"uniqueItems":true,"minItems":1},
        "dependsOn":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
        "min":{"type":"number"},
        "max":{"type":"number"}
      }
    },
    "option":{
      "type":"object","required":["value","label"],"additionalProperties":false,
      "properties":{"value":{"type":"string","minLength":1,"maxLength":64},"label":{"type":"string","minLength":1,"maxLength":64}}
    }
  }
}
