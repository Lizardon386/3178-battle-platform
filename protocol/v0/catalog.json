    {"type":"sync","from":"platform","to":"authority","schema":"PlatformSync","channel":"ipc","auth":"platform","summary":"请求权威向该成员补当前完整私密视图"},
    {"type":"closeSession","from":"platform","to":"authority","schema":"PlatformCloseSession","channel":"ipc","auth":"platform","summary":"通知权威回收会话"},
    {"type":"ping","from":"platform","to":"authority","schema":"PlatformPing","channel":"ipc","auth":"platform","summary":"本地 IPC 心跳"},

    {"type":"authorityReady","from":"authority","to":"platform","schema":"AuthorityReady","channel":"ipc","auth":"authority","summary":"权威初始化完成，回带 epoch，gameProcess 进入 running"},
    {"type":"deliver","from":"authority","to":"platform","schema":"AuthorityDeliver","channel":"ipc","auth":"authority","summary":"按 memberId 或全员投递 opaque 结果，带 gameSequence 与 epoch"},
