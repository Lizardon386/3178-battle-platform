{
  "protocolVersion": 0,
  "status": "s1-draft-no-runtime",
  "messages": [
    {"type":"hello","from":"client","to":"platform","schema":"ClientHello","channel":"any","auth":"none","summary":"平台协议与能力协商，不带大厅预选游戏版本"},
