{
  "name": "@bp/game-sdk",
  "version": "0.1.0",
  "description": "3178 游戏接入 SDK：游戏 ABI、客户端契约、单文件包和 game-kit",
  "license": "MIT",
  "author": "3178-battle-platform contributors",
  "homepage": "https://github.com/Lizardon386/3178-battle-platform#readme",
  "bugs": {
    "url": "https://github.com/Lizardon386/3178-battle-platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lizardon386/3178-battle-platform.git",
    "directory": "packages/game-sdk"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": ["3178", "game-platform", "game-sdk", "game-kit"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/contract/client.d.ts",
      "default": "./dist/contract/client.js"
    },
    "./node": {
      "types": "./dist/node/pack.d.ts",
      "default": "./dist/node/pack.js"
    },
    "./kit": {
      "types": "./dist/kit/client/index.d.ts",
      "default": "./dist/kit/client/index.js"
    },
    "./kit/server": {
      "types": "./dist/kit/server/index.d.ts",
      "default": "./dist/kit/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@bp/core-abi": "^0.1.0",
    "@bp/pack-format": "^0.1.0"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  }
}
