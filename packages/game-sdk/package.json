{
  "name": "@bp/game-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/contract/client.d.ts",
      "default": "./dist/contract/client.js"
    },
    "./node": {
      "types": "./dist/node/pack.d.ts",
      "default": "./dist/node/pack.js"
    },
    "./kit": {
      "types": "./dist/kit/client/index.d.ts",
      "default": "./dist/kit/client/index.js"
    },
    "./kit/server": {
      "types": "./dist/kit/server/index.d.ts",
      "default": "./dist/kit/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bpmap": "dist/cli/index.js"
  },
  "dependencies": {
    "@bp/protocol": "*"
  },
  "files": [
    "dist",
    "templates"
  ]
}
